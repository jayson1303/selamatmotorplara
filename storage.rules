rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Siapa saja boleh melihat/mengunduh (READ) foto produk, banner, dan testimoni
    // Hanya akun admin proyek yang dapat mengunggah/mengubah/menghapus.
    match /{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.token.email == 'andra@admin.com';
    }
  }
}
